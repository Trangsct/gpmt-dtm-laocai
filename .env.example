# Sao chép thành .env (KHÔNG commit .env). Trên Vercel: Project → Settings → Environment Variables.
DATABASE_URL=postgresql://<người dùng>:<mật khẩu>@<máy chủ Neon>/<tên CSDL>?sslmode=require
SECRET_KEY=<chuỗi ngẫu nhiên dài, vd: python3 -c "import secrets; print(secrets.token_hex(32))">
SESSION_COOKIE_SECURE=1
# Nơi lưu PDF gốc (riêng tư). Cục bộ: thư mục; Vercel: địa chỉ dịch vụ lưu tệp.
PDF_DIR=du-lieu-goc
PDF_BASE_URL=
TEN_DON_VI=Sở Nông nghiệp và Môi trường tỉnh Lào Cai
