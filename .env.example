# Sao chép thành .env để chạy cục bộ (KHÔNG commit .env). Trên Vercel: Project → Settings → Environment Variables.
# Tích hợp Neon trên Vercel tự đặt DATABASE_URL (hoặc POSTGRES_URL).
DATABASE_URL=postgresql://<người dùng>:<mật khẩu>@<máy chủ Neon>/<tên CSDL>?sslmode=require
# Tài khoản quản trị đầu tiên — chỉ được tạo khi CSDL chưa có tài khoản nào
QUAN_TRI_EMAIL=
QUAN_TRI_MAT_KHAU=
QUAN_TRI_HO_TEN=
# Không bắt buộc
SECRET_KEY=
SESSION_COOKIE_SECURE=
PDF_DIR=du-lieu-goc
PDF_BASE_URL=
TEN_DON_VI=Sở Nông nghiệp và Môi trường tỉnh Lào Cai
